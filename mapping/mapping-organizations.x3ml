<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="x3ml_v1.5.xsd"
      editor="3MEditor v3.3">

  <namespaces>
    <namespace prefix="sari" uri="https://hwgw.uzh.ch/"/>
    <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
    <namespace prefix="crmdig" uri="http://www.ics.forth.gr/isl/CRMdig/"/>
    <namespace prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
    <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
    <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
  </namespaces>

  <mappings>

    <!-- ORGANISATIONS -->
    <mapping>
      <domain>
        <source_node>//tei:listOrg/tei:org</source_node>
        <target_node>
          <entity>
            <type>crm:E74_Group</type>

            <instance_generator name="GroupURI">
              <arg name="group_id" type="xpath">@xml:id</arg>
            </instance_generator>

            <label_generator name="SimpleLabel">
              <arg name="label" type="xpath">tei:orgName[@type='main']/text()</arg>
            </label_generator>
          </entity>
        </target_node>
      </domain>

      <!-- ===================================================== -->
      <!-- Main organisation name -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:orgName[@type='main']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>

            <entity variable="main_appellation">
              <type>crm:E33_E41_Linguistic_Appellation</type>

              <instance_generator name="GroupAppellationShortURI">
                <arg name="group_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">text()</arg>
              </instance_generator>

              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">text()</arg>
              </label_generator>

              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                      <constant>preferred name</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">http://vocab.getty.edu/aat/300404670</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">preferred terms</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>

            <relationship>crm:P190_has_symbolic_content</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:orgName[@type='main']</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">text()</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Short organisation name -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:orgName[@type='short']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>

            <entity variable="short_appellation">
              <type>crm:E33_E41_Linguistic_Appellation</type>

              <instance_generator name="GroupAppellationShortURI">
                <arg name="group_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">text()</arg>
              </instance_generator>

              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">text()</arg>
              </label_generator>

              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                      <constant>short name</constant>
                  </instance_info>
                    <instance_generator name="URIorUUID">
                        <arg name="text" type="constant">https://vocab.getty.edu/aat/300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">brief titles</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                </entity>
              </additional>
            </entity>

            <relationship>crm:P190_has_symbolic_content</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:orgName[@type='short']</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">text()</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- xml:id as internal identifier -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>@xml:id</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>@xml:id</source_node>
          <target_node>
            <entity>
              <type>crm:E42_Identifier</type>
              <instance_generator name="GroupAppellationShortURI">
                <arg name="group_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">.</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">.</arg>
              </label_generator>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                    <constant>unique identifier</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">http://vocab.getty.edu/aat/300404012</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">unique identifiers</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">eindeutige Kennung</arg>
                    <arg name="language" type="constant">de</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- same-as link to external GND URI -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E74_Group</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://d-nb.info/gnd/', text())</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- same-as link to the real GND URI -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E74_Group</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://d-nb.info/gnd/', text())</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Place reference(s) -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:placeName[@ref]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P74_has_current_or_former_residence</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:placeName[@ref]</source_node>
          <target_node>
            <entity>
              <type>crm:E53_Place</type>
              <instance_generator name="PlaceURI">
                <arg name="place_id" type="xpath">@ref</arg>
            </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">text()</arg>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Plain note text -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:note</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:note</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(string(.))</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Note with rs[@type='organisation'][@ref] -->
      <!-- Treat as relation to a broader / related organisation -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:note/tei:rs[@type='organisation'][@ref]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P107i_is_current_or_former_member_of</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:note/tei:rs[@type='organisation'][@ref]</source_node>
          <target_node>
            <entity>
              <type>crm:E74_Group</type>
              <instance_generator name="GroupURI">
                <arg name="group_id" type="xpath">@ref</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">text()</arg>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

    </mapping>
  </mappings>
</x3ml>