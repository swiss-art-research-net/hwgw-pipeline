<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="x3ml_v1.5.xsd"
      editor="3MEditor v3.3">

  <namespaces>
    <namespace prefix="resource" uri="https://hwgw.uzh.ch/"/>
    <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
    <namespace prefix="crmdig" uri="http://www.ics.forth.gr/isl/CRMdig/"/>
    <namespace prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
    <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
    <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
  </namespaces>

  <mappings>

    <!-- ARTWORK OBJECTS                                      -->
    <!-- drawing, fresco, painting, print, relief, sculpture  -->
    <mapping>
      <domain>
        <source_node>//listObject//object[
          @type='drawing' or
          @type='fresco' or
          @type='medal' or
          @type='painting' or
          @type='print' or
          @type='relief' or
          @type='sculpture' or
          @type='tapestry' or
          @type='tomb'
        ]</source_node>
        <target_node>
          <entity>
            <type>crm:E22_Human-Made_Object</type>
            <instance_generator name="URIwithTypeAndId">
              <arg name="type" type="constant">artwork</arg>
              <arg name="id" type="xpath">@xml:id</arg>
            </instance_generator>
            <label_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(string(head[@type='main'][1]))</arg>
                <arg name="language" type="constant"/>
              </label_generator>
          </entity>
        </target_node>
      </domain>

      <!-- Main title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='main']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='main']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">name</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>preferred title</constant>
                    </instance_info>
                    <instance_generator name="URIwithAatId">
                        <arg name="id" type="constant">300404670</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">preferred title</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">Vorzugstitel</arg>
                        <arg name="language" type="constant">de</arg>
                    </label_generator>
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Alternative title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='alternative']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='alternative']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd2Levels_Level2Hashed">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">alternative-appellation</arg>
                <arg name="level2_HASHED_CONTENTS" type="xpath">concat('alternative-', normalize-space(.))</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>alternative title</constant>
                    </instance_info>
                    <instance_generator name="URIwithAatId">
                        <arg name="id" type="constant">300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">nonpreferred terms</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- HW title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='hw']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='hw']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd2Levels_Level2Hashed">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">hw-appellation</arg>
                <arg name="level2_HASHED_CONTENTS" type="xpath">concat('hw-', normalize-space(.))</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                      <constant>HW title</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">https://hwgw.uzh.ch/type/appellation/hw</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">HW title</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Object type from @type -->
      <link>
        <path>
          <source_relation>
            <relation>@type</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P2_has_type</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>@type</source_node>
          <target_node>
            <entity>
              <type>crm:E55_Type</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://hwgw.uzh.ch/type/object/', normalize-space(.))</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
                <arg name="language" type="constant">en</arg>
              </label_generator>
              <additional>
                <relationship>crm:P127_has_broader_term</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">https://hwgw.uzh.ch/type/object/artwork</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">artwork</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- GND identifier(s) from note/idno as same-as links -->
      <link>
        <path>
          <source_relation>
            <relation>note/idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E22_Human-Made_Object</type>
              <instance_generator name="URIwithGndId">
                <arg name="id" type="xpath">normalize-space(.)</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">concat(normalize-space(../../head[@type='main'][1]), ' in GND')</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Creator -->
      <!-- object -> production -> person -->
      <link>
        <path>
          <source_relation>
            <relation>note/persName[@role='creator'][@ref]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P14_carried_out_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/persName[@role='creator'][@ref]</source_node>
          <target_node>
            <entity>
              <type>crm:E21_Person</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">person</arg>
                <arg name="id" type="xpath">@ref</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Production date lower bound -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateLower]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82a_begin_of_the_begin</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateLower]</source_node>
          <target_node>
            <entity>
              <type>xsd:gYear</type>
              <instance_generator name="typedLiteralGen">
                <arg name="text" type="xpath">@preprocessed_dateLower</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date upper bound -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateUpper]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82b_end_of_the_end</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateUpper]</source_node>
          <target_node>
            <entity>
              <type>xsd:gYear</type>
              <instance_generator name="typedLiteralGen">
                <arg name="text" type="xpath">@preprocessed_dateUpper</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date qualifier type -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateQualifier]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P2_has_type</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateQualifier]</source_node>
          <target_node>
            <entity>
              <type>crm:E55_Type</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">dateQualifier</arg>
                <arg name="id" type="xpath">translate(normalize-space(@preprocessed_dateQualifier), '| ', '--')</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@preprocessed_dateQualifier</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date source phrase label -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[text()[normalize-space()]]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">artwork</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>rdfs:label</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[text()[normalize-space()]]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Full note as object note -->
      <link>
        <path>
          <source_relation>
            <relation>note[normalize-space(.)]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note[normalize-space(.)]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Material / dimension / inventory paragraph as note -->
      <link>
        <path>
          <source_relation>
            <relation>note/p[normalize-space(.)]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/p[normalize-space(.)]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Current keeper(s): all ancestor organisation containers -->
      <link>
        <path>
          <source_relation>
            <relation>ancestor::listObject[@type='organisation'][@corresp]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P50_has_current_keeper</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>ancestor::listObject[@type='organisation'][@corresp]</source_node>
          <target_node>
            <entity>
              <type>crm:E74_Group</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">group</arg>
                <arg name="id" type="xpath">@corresp</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@n</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Current location: ancestor place container(s) -->
      <link>
        <path>
          <source_relation>
            <relation>ancestor::listObject[@type='place'][@corresp]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P55_has_current_location</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>ancestor::listObject[@type='place'][@corresp]</source_node>
          <target_node>
            <entity>
              <type>crm:E53_Place</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">place</arg>
                <arg name="id" type="xpath">@corresp</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@n</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

    </mapping>


    <!-- BUILT WORK OBJECTS -->
    <!-- altarpiece, built_work, fountain, furniture,open_space -->
    <mapping>
      <domain>
        <source_node>//listObject//object[
          @type='altarpiece' or
          @type='built_work' or
          @type='fountain' or
          @type='furniture' or
          @type='open_space'
        ]</source_node>
        <target_node>
          <entity>
            <type>crm:E22_Human-Made_Object</type>
            <instance_generator name="URIwithTypeAndId">
              <arg name="type" type="constant">built_work</arg>
              <arg name="id" type="xpath">@xml:id</arg>
            </instance_generator>
            <label_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(string(head[@type='main'][1]))</arg>
                <arg name="language" type="constant"/>
              </label_generator>
          </entity>
        </target_node>
      </domain>

      <!-- Main title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='main']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='main']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">name</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>preferred title</constant>
                    </instance_info>
                    <instance_generator name="URIwithAatId">
                        <arg name="id" type="constant">300404670</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">preferred title</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">Vorzugstitel</arg>
                        <arg name="language" type="constant">de</arg>
                    </label_generator>
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Alternative title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='alternative']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='alternative']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd2Levels_Level2Hashed">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">alternative-appellation</arg>
                <arg name="level2_HASHED_CONTENTS" type="xpath">concat('alternative-', normalize-space(.))</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>alternative title</constant>
                    </instance_info>
                    <instance_generator name="URIwithAatId">
                        <arg name="id" type="constant">300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">alternative title</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                    <!-- <label_generator name="Literal">
                        <arg name="text" type="constant">Alternativer Titel</arg>
                        <arg name="language" type="constant">de</arg>
                    </label_generator> -->
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- HW title -->
      <link>
        <path>
          <source_relation>
            <relation>head[@type='hw']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>head[@type='hw']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="URIwithTypeIdAnd2Levels_Level2Hashed">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../@xml:id</arg>
                <arg name="level1" type="constant">hw-appellation</arg>
                <arg name="level2_HASHED_CONTENTS" type="xpath">concat('hw-', normalize-space(.))</arg>
              </instance_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                      <constant>HW title</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">https://hwgw.uzh.ch/type/appellation/hw</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">HW title</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Object type from @type -->
      <link>
        <path>
          <source_relation>
            <relation>@type</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P2_has_type</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>@type</source_node>
          <target_node>
            <entity>
              <type>crm:E55_Type</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://hwgw.uzh.ch/type/object/', normalize-space(.))</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
                <arg name="language" type="constant">en</arg>
              </label_generator>
              <additional>
                <relationship>crm:P127_has_broader_term</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">https://hwgw.uzh.ch/type/object/built_work</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">built work</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- GND identifier(s) from note/idno as same-as links -->
      <link>
        <path>
          <source_relation>
            <relation>note/idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E22_Human-Made_Object</type>
              <instance_generator name="URIwithGndId">
                <arg name="id" type="xpath">normalize-space(.)</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">concat(normalize-space(../../head[@type='main'][1]), ' in GND')</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Creator -->
      <!-- object -> production -> person -->
      <link>
        <path>
          <source_relation>
            <relation>note/persName[@role='creator'][@ref]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P14_carried_out_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/persName[@role='creator'][@ref]</source_node>
          <target_node>
            <entity>
              <type>crm:E21_Person</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">person</arg>
                <arg name="id" type="xpath">@ref</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Production date lower bound -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateLower]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82a_begin_of_the_begin</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateLower]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">@preprocessed_dateLower</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date upper bound -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateUpper]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82b_end_of_the_end</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateUpper]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">@preprocessed_dateUpper</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date qualifier type -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[@preprocessed_dateQualifier]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P2_has_type</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[@preprocessed_dateQualifier]</source_node>
          <target_node>
            <entity>
              <type>crm:E55_Type</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">dateQualifier</arg>
                <arg name="id" type="xpath">translate(normalize-space(@preprocessed_dateQualifier), '| ', '--')</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@preprocessed_dateQualifier</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- Production date source phrase label -->
      <link>
        <path>
          <source_relation>
            <relation>note/preprocessed_date[text()[normalize-space()]]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P108i_was_produced_by</relationship>
            <entity>
              <type>crm:E12_Production</type>
              <instance_generator name="URIwithTypeIdAnd1Level">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">production</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity>
              <type>crm:E52_Time-Span</type>
              <instance_generator name="URIwithTypeIdAnd2Levels">
                <arg name="type" type="constant">built_work</arg>
                <arg name="id" type="xpath">../../@xml:id</arg>
                <arg name="level1" type="constant">creation</arg>
                <arg name="level2" type="constant">date</arg>
              </instance_generator>
            </entity>
            <relationship>rdfs:label</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/preprocessed_date[text()[normalize-space()]]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Full note as object note -->
      <link>
        <path>
          <source_relation>
            <relation>note[normalize-space(.)]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note[normalize-space(.)]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Material / dimension / inventory paragraph as note -->
      <link>
        <path>
          <source_relation>
            <relation>note/p[normalize-space(.)]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>note/p[normalize-space(.)]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Current keeper(s): all ancestor organisation containers -->
      <link>
        <path>
          <source_relation>
            <relation>ancestor::listObject[@type='organisation'][@corresp]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P50_has_current_keeper</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>ancestor::listObject[@type='organisation'][@corresp]</source_node>
          <target_node>
            <entity>
              <type>crm:E74_Group</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">group</arg>
                <arg name="id" type="xpath">@corresp</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@n</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Current location: ancestor place container(s) -->
      <link>
        <path>
          <source_relation>
            <relation>ancestor::listObject[@type='place'][@corresp]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P55_has_current_location</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>ancestor::listObject[@type='place'][@corresp]</source_node>
          <target_node>
            <entity>
              <type>crm:E53_Place</type>
              <instance_generator name="URIwithTypeAndId">
                <arg name="type" type="constant">place</arg>
                <arg name="id" type="xpath">@corresp</arg>
              </instance_generator>
              <label_generator name="Literal">
                <arg name="text" type="xpath">@n</arg>
                <arg name="language" type="constant"/>
              </label_generator>
            </entity>
          </target_node>
        </range>
      </link>

    </mapping>

  </mappings>
</x3ml>