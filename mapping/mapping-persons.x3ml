<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="x3ml_v1.5.xsd"
      editor="3MEditor v3.3">

  <namespaces>
    <namespace prefix="sari" uri="https://hwgw.uzh.ch/"/>
    <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
    <namespace prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
    <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
    <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
    <namespace prefix="crmdig" uri="http://www.ics.forth.gr/isl/CRMdig/"/>
  </namespaces>

  <mappings>

    <!-- PERSON -->
    <mapping>
      <domain>
        <source_node>//tei:listPerson/tei:person</source_node>
        <target_node>
          <entity>
            <type>crm:E21_Person</type>
            <instance_generator name="PersonURI">
              <arg name="person_id" type="xpath">@xml:id</arg>
            </instance_generator>
            <label_generator name="SimpleLabel">
              <arg name="label" type="xpath">tei:persName[@type='main']/text()</arg>
            </label_generator>
          </entity>
        </target_node>
      </domain>

      <!-- Preferred main name -->
      <link>
        <path>
          <source_relation>
            <relation>tei:persName[@type='main']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:persName[@type='main']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="PersonAppellationShortURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">normalize-space(.)</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">normalize-space(.)</arg>
              </label_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>preferred name</constant>
                    </instance_info>
                    <instance_generator name="URIorUUID">
                        <arg name="text" type="constant">http://vocab.getty.edu/aat/300404670</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">preferred terms</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                </entity>
            </additional>
            </entity>
          </target_node>          
        </range>
      </link>

      <!-- Alternative names -->
      <link>
        <path>
          <source_relation>
            <relation>tei:persName[@type='alternative']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:persName[@type='alternative']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="PersonAppellationShortURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">concat('alternative-', normalize-space(.))</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">normalize-space(.)</arg>
              </label_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>alternative name</constant>
                    </instance_info>
                    <instance_generator name="URIorUUID">
                        <arg name="text" type="constant">https://vocab.getty.edu/aat/300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">nonpreferred terms</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Note -->
      <link>
        <path>
          <source_relation>
            <relation>tei:note</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:note</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- xml:id as identifier -->
      <link>
        <path>
          <source_relation>
            <relation>@xml:id</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>@xml:id</source_node>
          <target_node>
            <entity>
              <type>crm:E42_Identifier</type>
              <instance_generator name="PersonAppellationShortURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">.</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">.</arg>
              </label_generator>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                    <constant>unique identifier</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">http://vocab.getty.edu/aat/300404012</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">unique identifiers</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">eindeutige Kennung</arg>
                    <arg name="language" type="constant">de</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>          
        </range>
      </link>

      <!-- GND identifier -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E21_Person</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://d-nb.info/gnd/', normalize-space(.))</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- VIAF identifier -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='VIAF']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:idno[@type='VIAF']</source_node>
          <target_node>
            <entity>
              <type>crm:E21_Person</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://viaf.org/viaf/', normalize-space(.))</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ULAN identifier -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='ULAN']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:idno[@type='ULAN']</source_node>
          <target_node>
            <entity>
              <type>crm:E21_Person</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('http://vocab.getty.edu/ulan/', normalize-space(.))</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- ===================================================== -->
      <!-- Birth event -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:birth</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P98i_was_born</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:birth</source_node>
          <target_node>
            <entity variable="birth_event">
              <type>crm:E67_Birth</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Birth year from @when: begin -->
      <link>
        <path>
          <source_relation>
            <relation>tei:birth/@when</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P98i_was_born</relationship>
            <entity variable="birth_event">
              <type>crm:E67_Birth</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity variable="birth_timespan">
              <type>crm:E52_Time-Span</type>
              <instance_generator name="PersonUniqueEventTimeSpanURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82a_begin_of_the_begin</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:birth/@when</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Birth year from @when: end -->
      <link>
        <path>
          <source_relation>
            <relation>tei:birth/@when</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P98i_was_born</relationship>
            <entity variable="birth_event">
              <type>crm:E67_Birth</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity variable="birth_timespan">
              <type>crm:E52_Time-Span</type>
              <instance_generator name="PersonUniqueEventTimeSpanURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82b_end_of_the_end</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:birth/@when</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Birth textual note when content exists -->
      <link>
        <path>
          <source_relation>
            <relation>tei:birth[text()[normalize-space()]]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P98i_was_born</relationship>
            <entity variable="birth_event">
              <type>crm:E67_Birth</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="event_type" type="constant">birth</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:birth[text()[normalize-space()]]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Death event -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:death</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P100i_died_in</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:death</source_node>
          <target_node>
            <entity variable="death_event">
              <type>crm:E69_Death</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Death year from @when: begin -->
      <link>
        <path>
          <source_relation>
            <relation>tei:death/@when</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P100i_died_in</relationship>
            <entity variable="death_event">
              <type>crm:E69_Death</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity variable="death_timespan">
              <type>crm:E52_Time-Span</type>
              <instance_generator name="PersonUniqueEventTimeSpanURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82a_begin_of_the_begin</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:death/@when</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Death year from @when: end -->
      <link>
        <path>
          <source_relation>
            <relation>tei:death/@when</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P100i_died_in</relationship>
            <entity variable="death_event">
              <type>crm:E69_Death</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P4_has_time-span</relationship>
            <entity variable="death_timespan">
              <type>crm:E52_Time-Span</type>
              <instance_generator name="PersonUniqueEventTimeSpanURI">
                <arg name="person_id" type="xpath">../../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P82b_end_of_the_end</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:death/@when</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">.</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- Death textual note when content exists -->
      <link>
        <path>
          <source_relation>
            <relation>tei:death[text()[normalize-space()]]</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P100i_died_in</relationship>
            <entity variable="death_event">
              <type>crm:E69_Death</type>
              <instance_generator name="PersonUniqueEventURI">
                <arg name="person_id" type="xpath">../@xml:id</arg>
                <arg name="event_type" type="constant">death</arg>
              </instance_generator>
            </entity>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:death[text()[normalize-space()]]</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

    </mapping>

  </mappings>
</x3ml>