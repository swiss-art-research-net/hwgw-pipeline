                                            <arg name="type" type="constant">person</arg>
                                            <arg name="id" type="xpath">../@xml:id</arg>
                                            <arg name="level1" type="constant">death</arg>
                                            <arg name="level2" type="constant">date</arg>
                                        </instance_generator>
                                    </entity>
                                    <relationship>crm:P2_has_type</relationship>
                                </target_relation>
                            </path>
                            <range>
                                <source_node>preprocessed_death[@preprocessed_dateQualifier]</source_node>
                                <target_node>
                                    <entity>
                                        <type>crm:E55_Type</type>
                                        <instance_generator name="URIwithTypeAndId">
                                            <arg name="type" type="constant">dateQualifier</arg>
                                            <arg name="id" type="xpath">translate(normalize-space(@preprocessed_dateQualifier), '| ', '--')</arg>
                                        </instance_generator>
                                        <label_generator name="Literal">
                                            <arg name="text" type="xpath">@preprocessed_dateQualifier</arg>
                                            <arg name="language" type="constant"/>
                                        </label_generator>
                                    </entity>
                                </target_node>
                            </range>
                        </link>
                        <link>
                            <path>
                                <source_relation>
                                    <relation>preprocessed_death[text()[normalize-space()]]</relation>
                                </source_relation>
                                <target_relation>
                                    <relationship>crm:P100i_died_in</relationship>
                                    <entity>
                                        <type>crm:E69_Death</type>
                                        <instance_generator name="URIwithTypeIdAnd1Level">
                                            <arg name="type" type="constant">person</arg>
                                            <arg name="id" type="xpath">../@xml:id</arg>
                                            <arg name="level1" type="constant">death</arg>
                                        </instance_generator>
                                        <label_generator name="Literal">
                                            <arg name="text" type="xpath">concat('Death of ', ../persName[@type='main']/text())</arg>
                                            <arg name="language" type="constant"/>
                                        </label_generator>
                                    </entity>
                                    <relationship>crm:P4_has_time-span</relationship>
                                    <entity>
                                        <type>crm:E52_Time-Span</type>
                                        <instance_generator name="URIwithTypeIdAnd2Levels">
                                            <arg name="type" type="constant">person</arg>
                                            <arg name="id" type="xpath">../@xml:id</arg>
                                            <arg name="level1" type="constant">death</arg>
                                            <arg name="level2" type="constant">date</arg>
                                        </instance_generator>
                                    </entity>
                                    <relationship>rdfs:label</relationship>
                                </target_relation>
                            </path>
                            <range>
                                <source_node>preprocessed_death[text()[normalize-space()]]</source_node>
                                <target_node>
                                    <entity>
                                        <type>rdfs:Literal</type>
                                        <instance_generator name="Literal">
                                            <arg name="text" type="xpath">normalize-space(.)</arg>
                                        </instance_generator>
                                    </entity>
                                </target_node>
                            </range>
                        </link>
                    </mapping>
                </mappings>
</x3ml>