<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="x3ml_v1.5.xsd"
      editor="3MEditor v3.3">

  <namespaces>
    <namespace prefix="sari" uri="https://hwgw.uzh.ch/"/>
    <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
    <namespace prefix="crmdig" uri="http://www.ics.forth.gr/isl/CRMdig/"/>
    <namespace prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
    <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
    <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
  </namespaces>

  <mappings>

    <!-- ========================================================= -->
    <!-- PLACE -->
    <!-- ========================================================= -->
    <mapping>
      <domain>
        <source_node>//tei:listPlace/tei:place</source_node>
        <target_node>
          <entity>
            <type>crm:E53_Place</type>

            <instance_generator name="PlaceURI">
              <arg name="place_id" type="xpath">@xml:id</arg>
            </instance_generator>

            <label_generator name="SimpleLabel">
              <arg name="label" type="xpath">tei:placeName[@type='main'][1]/text()</arg>
            </label_generator>
          </entity>
        </target_node>
      </domain>

      <!-- ===================================================== -->
      <!-- Preferred main place name -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:placeName[@type='main']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:placeName[@type='main']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="PlaceAppellationShortURI">
                <arg name="place_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">normalize-space(.)</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">normalize-space(.)</arg>
              </label_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>preferred place name</constant>
                    </instance_info>
                    <instance_generator name="URIorUUID">
                        <arg name="text" type="constant">https://vocab.getty.edu/aat/300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">preferred terms</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                    <!-- <label_generator name="Literal">
                        <arg name="text" type="constant">Alternativer Name</arg>
                        <arg name="language" type="constant">de</arg>
                    </label_generator> -->
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Alternative place names -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:placeName[@type='alternative']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:placeName[@type='alternative']</source_node>
          <target_node>
            <entity>
              <type>crm:E33_E41_Linguistic_Appellation</type>
              <instance_generator name="PlaceAppellationShortURI">
                <arg name="place_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">concat('alternative-', normalize-space(.))</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">normalize-space(.)</arg>
              </label_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                    <type>crm:E55_Type</type>
                    <instance_info>
                        <constant>alternative name</constant>
                    </instance_info>
                    <instance_generator name="URIorUUID">
                        <arg name="text" type="constant">https://vocab.getty.edu/aat/300264273</arg>
                    </instance_generator>
                    <label_generator name="Literal">
                        <arg name="text" type="constant">alternative name</arg>
                        <arg name="language" type="constant">en</arg>
                    </label_generator>
                    <!-- <label_generator name="Literal">
                        <arg name="text" type="constant">Alternativer Name</arg>
                        <arg name="language" type="constant">de</arg>
                    </label_generator> -->
                </entity>
            </additional>
            </entity>
          </target_node>
        </range>
      </link>
      <!-- ===================================================== -->
      <!-- xml:id as internal identifier -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>@xml:id</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>@xml:id</source_node>
          <target_node>
            <entity>
              <type>crm:E42_Identifier</type>
              <instance_generator name="PlaceAppellationShortURI">
                <arg name="place_id" type="xpath">../@xml:id</arg>
                <arg name="appellation_id" type="xpath">.</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">.</arg>
              </label_generator>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_info>
                    <constant>unique identifier</constant>
                  </instance_info>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">http://vocab.getty.edu/aat/300404012</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">unique identifiers</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">eindeutige Kennung</arg>
                    <arg name="language" type="constant">de</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- GND identifier -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P1_is_identified_by</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E42_Identifier</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://hwgw.uzh.ch/place/', ../../@xml:id, '/identifier/gnd/', normalize-space(.))</arg>
              </instance_generator>
              <label_generator name="SimpleLabel">
                <arg name="label" type="xpath">normalize-space(.)</arg>
              </label_generator>
              <additional>
                <relationship>crm:P190_has_symbolic_content</relationship>
                <entity>
                  <type>rdfs:Literal</type>
                  <instance_generator name="Literal">
                    <arg name="text" type="xpath">normalize-space(.)</arg>
                  </instance_generator>
                </entity>
              </additional>
              <additional>
                <relationship>crm:P2_has_type</relationship>
                <entity>
                  <type>crm:E55_Type</type>
                  <instance_generator name="URIorUUID">
                    <arg name="text" type="constant">https://hwgw.uzh.ch/type/identifier/gnd</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                    <arg name="text" type="constant">GND identifier</arg>
                    <arg name="language" type="constant">en</arg>
                  </label_generator>
                </entity>
              </additional>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- same-as link to external GND URI -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:idno[@type='GND']</relation>
          </source_relation>
          <target_relation>
            <relationship>crmdig:L54_is_same-as</relationship>
          </target_relation>
        </path>

        <range>
          <source_node>tei:idno[@type='GND']</source_node>
          <target_node>
            <entity>
              <type>crm:E53_Place</type>
              <instance_generator name="URIorUUID">
                <arg name="text" type="xpath">concat('https://d-nb.info/gnd/', text())</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>

      <!-- ===================================================== -->
      <!-- Note -->
      <!-- ===================================================== -->
      <link>
        <path>
          <source_relation>
            <relation>tei:note</relation>
          </source_relation>
          <target_relation>
            <relationship>crm:P3_has_note</relationship>
          </target_relation>
        </path>
        <range>
          <source_node>tei:note</source_node>
          <target_node>
            <entity>
              <type>rdfs:Literal</type>
              <instance_generator name="Literal">
                <arg name="text" type="xpath">normalize-space(.)</arg>
              </instance_generator>
            </entity>
          </target_node>
        </range>
      </link>
    </mapping>
  </mappings>
</x3ml>