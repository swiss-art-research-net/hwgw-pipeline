PROJECT_NAME=hwgw-pipeline

GITHUB_USERNAME=xxx
GITHUB_PERSONAL_ACCESS_TOKEN=xxx

# production
# COMPOSE_FILE=./docker-compose.base.yml:./docker-compose.prod.yml

# Develop
COMPOSE_FILE=./docker-compose.base.yml:./docker-compose.local.yml

DATABASE_URI=sqlite:///../app.db
DTSCATALOG=/dts_data/catalog/hwgw-edition/collection.xml
# test
# DTSCATALOG=tests/catalog/example-collection.xml
SERVER_PORT=8000
SERVER_ENV=prod
SERVER_HOST=0.0.0.0

DAPYTAINS_VERSION=1.0.0rc2
# Set true only when demonstrating the web viewer locally.
DAPYTAINS_VIEWER_WORKAROUND=false

QLEVER_ACCESS_TOKEN=changeme
PORT_QLEVER=7011
PORT_QLEVER_UI=7012

# QLever UI superuser (created automatically on first start)
QLEVER_UI_USERNAME=admin
QLEVER_UI_EMAIL=admin@example.com
QLEVER_UI_PASSWORD=changeme

RDS_ENDPOINT=https://reconcile.rds.swissartresearch.net/

DTS_ENDPOINT=https://rs4.ethz.ch/dts/

# Production only (reverse-proxy overlay)
# PROXY_NETWORK_NAME=

HWGW_NAMESPACE=http://hwgw.uzh.ch/